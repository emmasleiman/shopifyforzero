# Copy to .env.local and fill in. .env.local is git-ignored; never commit a real key.
OPENROUTER_API_KEY=
# Optional: any Claude model on OpenRouter (default anthropic/claude-sonnet-5.5)
OPENROUTER_MODEL=
# Optional: the store's "today" (default 2025-10-27, the last day of the order history)
STORE_TODAY=
